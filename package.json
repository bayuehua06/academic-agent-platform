{
  "name": "academic-agent-platform",
  "version": "1.3.1",
  "private": true,
  "description": "Academic Agent Platform — frontend + backend monorepo scripts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start:all": "./start.sh",
    "stop:all": "./stop.sh",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node scripts/run-backend.mjs",
    "test:backend": "cd backend && .venv/bin/python -m pytest -q",
    "install:all": "npm install && npm install --prefix frontend",
    "ensure:db": "./scripts/ensure-db.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
