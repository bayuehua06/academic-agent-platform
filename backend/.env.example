# Application
APP_NAME=Academic Agent Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://academic:academic_secret@localhost:5432/academic_agent

# CORS
CORS_ORIGINS=["http://localhost:1980"]

# Zotero
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Browser / NotebookLM 抓取（推荐 CDP + 专用 Profile）
# 新版 Chrome 会在默认用户目录上忽略 remote-debugging-port。
# 先 Cmd+Q 退出 Chrome，再运行: ./scripts/start-chrome-debug.sh
CHROME_CDP_URL=http://127.0.0.1:9222
NOTEBOOKLM_HEADLESS=false
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIRECTORY=Default

# Paths
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
APA_CSL_PATH=./resources/apa.csl
