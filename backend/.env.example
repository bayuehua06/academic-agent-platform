# Application
APP_NAME=Academic Agent Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://academic:academic_secret@localhost:5432/academic_agent

# CORS
CORS_ORIGINS=["http://localhost:1980"]

# Zotero（本机；从 https://www.zotero.org/settings/keys 创建）
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user

# AUT Library 登录（本机；勿提交真实值）
AUT_USERNAME=
AUT_PASSWORD=

# 检索库入口（AUT 代理；全局共用）
LITERATURE_DB_IEEE_URL=https://library.aut.ac.nz/databases/ieee-xplore
LITERATURE_DB_ACM_URL=https://library.aut.ac.nz/databases/acm-digital-library
# 新建项目默认启用（逗号分隔）；可被项目 literature_databases 覆盖
LITERATURE_DEFAULT_DATABASES=ieee
# 测试用固定检索词（正式按章 LLM 后可手填/自动生成）
LITERATURE_TEST_QUERY=food delivery transformation

# OpenAI / LLM
OPENAI_API_KEY=
# Summarizer / Z5 / 约束抽取（便宜）
OPENAI_MODEL=gpt-4o-mini
# Writer 长文专用（空则回退 OPENAI_MODEL）
OPENAI_WRITER_MODEL=gpt-4o

# Browser / NotebookLM 抓取（推荐 CDP + 专用 Profile）
# 新版 Chrome 会在默认用户目录上忽略 remote-debugging-port。
# 先 Cmd+Q 退出 Chrome，再运行: ./scripts/start-chrome-debug.sh
CHROME_CDP_URL=http://127.0.0.1:9222
NOTEBOOKLM_HEADLESS=false
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIRECTORY=Default

# Paths
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
APA_CSL_PATH=./resources/apa.csl
